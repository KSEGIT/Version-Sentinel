{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "version-sentinel-startup-audit",
            "command": "bash \"${extensionPath}${/}scripts${/}session-start.sh\" --gemini",
            "timeout": 120000,
            "description": "Suggest an optional dependency audit without registry requests"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "version-sentinel-manifest-edit",
            "command": "bash \"${extensionPath}${/}scripts${/}detect-manifest-edit.sh\" --gemini",
            "timeout": 60000,
            "description": "Warn about dependency-manifest edits without a recorded version check"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "version-sentinel-install-cmd",
            "command": "bash \"${extensionPath}${/}scripts${/}detect-install-cmd.sh\" --gemini",
            "timeout": 60000,
            "description": "Warn about package-install commands without a recorded version check"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command|write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "version-sentinel-auto-record",
            "command": "bash \"${extensionPath}${/}scripts${/}auto-record.sh\" --gemini",
            "timeout": 180000,
            "description": "Warn about changed npm security evidence without delaying tools"
          }
        ]
      }
    ]
  }
}
