{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/prereq-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-manifest-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*npm*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pnpm*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*yarn*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*bun*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pip*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pip3*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*poetry*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*uv*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*cargo*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          },
          {
            "type": "command",
            "if": "Bash(*dotnet*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/detect-install-cmd.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*npm*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pnpm*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*yarn*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*bun*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pip*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*pip3*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*poetry*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*uv*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*cargo*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          },
          {
            "type": "command",
            "if": "Bash(*dotnet*)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/auto-record.sh"
          }
        ]
      }
    ]
  }
}
