{
  "name": "version-sentinel",
  "version": "0.7.0",
  "description": "Warns about dependency version checks and recommends upstream verification. Never blocks tools.",
  "keywords": [
    "dependencies",
    "packages",
    "versions",
    "guardrails",
    "hooks",
    "supply-chain-security"
  ],
  "author": {
    "name": "Daniel Kiska",
    "url": "https://github.com/KSEGIT"
  },
  "homepage": "https://github.com/KSEGIT/Version-Sentinel#readme",
  "license": "MIT",
  "skills": "./skills/",
  "commands": "./platforms/kimi/commands/",
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "*",
      "command": "bash ./scripts/session-start.sh",
      "timeout": 180
    },
    {
      "event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit",
      "command": "bash ./scripts/detect-manifest-edit.sh",
      "timeout": 180
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "bash ./scripts/detect-install-cmd.sh",
      "timeout": 180
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Edit|Write|MultiEdit|apply_patch",
      "command": "bash ./scripts/auto-record.sh",
      "timeout": 180
    }
  ],
  "interface": {
    "displayName": "Version Sentinel",
    "shortDescription": "Warns about dependency version checks and recommends upstream verification. Never blocks tools."
  }
}
