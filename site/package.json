{
  "name": "version-sentinel-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "env -u NO_COLOR playwright test",
    "check:html": "html-validate public/index.html",
    "check:links": "node tools/check-links.mjs",
    "check:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "profile:motion": "node tools/profile-motion.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "html-validate": "11.17.0"
  }
}
