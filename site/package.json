{
  "name": "version-sentinel-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "env -u NO_COLOR playwright test",
    "check:html": "node tools/check-html.mjs",
    "test:tools": "node --test tests/tools/*.test.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "profile:motion": "node tools/profile-motion.mjs"
  },
  "overrides": {
    "lighthouse": "13.5.0",
    "tmp": "0.2.7",
    "basic-ftp": "6.2.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "html-validate": "11.17.0"
  }
}
